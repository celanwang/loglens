# LLM Provider：deepseek（默认，优先）或 qwen；也可设为 auto 按已配置的 Key 自动推断
LLM_PROVIDER=deepseek

# 通用 Key（可选）：设置后优先于各 Provider 专用 Key
# LLM_API_KEY=sk-xxx

# DeepSeek（默认 Provider）
DEEPSEEK_API_KEY=sk-xxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# 阿里云百炼 qwen（备选；LLM_PROVIDER=qwen 时启用，并改用下行 URL 与模型）
# DASHSCOPE_API_KEY=sk-xxx
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen3.7-plus

# 未设置对应 Provider 的 Key 时，会依次回退 LLM_API_KEY 与另一家 Provider 的 Key

LLM_TIMEOUT=30s
LLM_ENABLED=true
